# Copy to /opt/mc-dashboard/dashboard.env and adjust. All values are optional.

# Paper server directory and the save folder to report on
DASH_SERVER_DIR=/opt/minecraft
DASH_WORLD=world
# Name shown in the page header and browser tab
DASH_TITLE=world
# Where the web server listens. Use 127.0.0.1:8123 if only a reverse proxy should reach it.
DASH_BIND=0.0.0.0:8123
# Map tiles in squaremap's layout (any renderer writing <world>/<zoom>/<x>_<z>.png works)
DASH_TILE_DIR=/opt/minecraft/plugins/squaremap/web/tiles
# UTC offset of the timestamps in the server's logs (8 = China Standard Time)
DASH_UTC_OFFSET=8
# Daily restart time shown in the status bar (e.g. when a backup job restarts the server)
DASH_RESTART=04:30
